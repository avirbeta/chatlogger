{
  "schemaVersion": 1,
  "id": "chatlogger",
  "version": "${version}",
  "name": "Чат-логгер",
  "description": "Автоматически сохраняет весь чат в папку .minecraft/chat/. Файл = название сервера. Каждая сессия помечается временем и IP.",
  "authors": [
    "vizor"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.vizor.chatlogger.ChatLoggerMod"
    ]
  },
  "mixins": [
    "chatlog.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.11.0",
    "fabric": "*",
    "minecraft": "~1.16.5"
  }
}
